# Harmless probes by prebuilt or platform code.
# The QTI camera HAL enumerates every property it can see.
dontaudit hal_camera_default property_type:file { getattr map open read };
dontaudit hal_thermal_default self:capability dac_read_search;
dontaudit priv_app device:dir { open read };
dontaudit priv_app proc_version:file { getattr open read };
dontaudit vendor_modprobe self:key write;
dontaudit vendor_agmservice_qti debugfs:dir r_dir_perms;
# hwui and SurfaceFlinger probe QTI's QSPM HAL; qcom only dontaudits some callers.
dontaudit { appdomain bootanim surfaceflinger } vendor_hal_qspmhal_default:binder call;
dontaudit vendor_poweroffalarm_app default_android_service:service_manager find;
# Vendor GL/media code in app processes enumerates all properties.
dontaudit appdomain property_type:file { getattr map open read };
# EvoX init.rc clears its /data/adb leftovers; system_server stats the dir.
dontaudit system_server adb_data_file:dir getattr;
dontaudit toolbox adb_data_file:dir search;
