+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.quickstep.util;
+
+import android.content.Context;
+import android.content.res.Resources;
+
+import com.android.launcher3.util.VisualEffects;
+import com.android.systemui.shared.system.QuickStepContract;
+
+/**
+ * {@link QuickStepContract}'s window corner radius, for the launcher's window animations, honouring
+ * the "Rounded corners in animations" toggle. Any corner radius on an animating window surface
+ * makes SurfaceFlinger compose it (and everything below it) on the GPU.
+ */
+public final class WindowCorners {
+
+    private WindowCorners() { }
+
+    /** The window corner radius, or 0 when the user turned rounded corners in animations off. */
+    public static float getWindowCornerRadius(Context context) {
+        return VisualEffects.windowCornersEnabled()
+                ? QuickStepContract.getWindowCornerRadius(context) : 0;
+    }
+
+    /** Whether windows are rounded, and the user kept rounded corners in animations. */
+    public static boolean supportsRoundedCornersOnWindows(Resources resources) {
+        return VisualEffects.windowCornersEnabled()
+                && QuickStepContract.supportsRoundedCornersOnWindows(resources);
+    }
+}
