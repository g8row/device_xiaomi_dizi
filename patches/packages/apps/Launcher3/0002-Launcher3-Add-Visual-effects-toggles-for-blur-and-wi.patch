diff --git a/src/com/android/launcher3/util/VisualEffects.java b/src/com/android/launcher3/util/VisualEffects.java
new file mode 100644
index 0000000000..956f49651f
--- /dev/null
+++ b/src/com/android/launcher3/util/VisualEffects.java
@@ -0,0 +1,97 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.launcher3.util;
+
+import android.app.ActivityThread;
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import com.android.launcher3.Flags;
+import com.android.launcher3.LauncherFiles;
+
+/**
+ * User toggles for the launcher's expensive visual effects (Settings > Visual effects). Blur and
+ * rounded window corners in transitions force SurfaceFlinger to compose those layers on the GPU,
+ * which is where most of the transition jank on mid-range GPUs comes from.
+ *
+ * The blur getters stand in for the aconfig flags of the same name: they return the flag value
+ * AND the user's choice, so with a toggle off the launcher takes the flag-off code path. Values are
+ * read once per process; {@link #KEYS} changes restart the launcher (see SettingsActivity).
+ */
+public final class VisualEffects {
+
+    public static final String KEY_BLUR_ALL_APPS = "pref_blur_all_apps";
+    public static final String KEY_BLUR_OVERVIEW = "pref_blur_overview";
+    public static final String KEY_BLUR_BEHIND_APPS = "pref_blur_behind_apps";
+    public static final String KEY_WINDOW_CORNERS = "pref_window_corners";
+    public static final String[] KEYS = {
+            KEY_BLUR_ALL_APPS, KEY_BLUR_OVERVIEW, KEY_BLUR_BEHIND_APPS, KEY_WINDOW_CORNERS };
+
+    private static volatile boolean sLoaded;
+    private static boolean sBlurAllApps;
+    private static boolean sBlurOverview;
+    private static boolean sBlurBehindApps;
+    private static boolean sWindowCorners = true;
+
+    private VisualEffects() { }
+
+    private static void load() {
+        if (sLoaded) {
+            return;
+        }
+        synchronized (VisualEffects.class) {
+            if (sLoaded) {
+                return;
+            }
+            Context context = ActivityThread.currentApplication();
+            if (context != null) {
+                SharedPreferences prefs = context.getSharedPreferences(
+                        LauncherFiles.SHARED_PREFERENCES_KEY, Context.MODE_PRIVATE);
+                sBlurAllApps = prefs.getBoolean(KEY_BLUR_ALL_APPS, false);
+                sBlurOverview = prefs.getBoolean(KEY_BLUR_OVERVIEW, false);
+                sBlurBehindApps = prefs.getBoolean(KEY_BLUR_BEHIND_APPS, false);
+                sWindowCorners = prefs.getBoolean(KEY_WINDOW_CORNERS, true);
+                sLoaded = true;
+            }
+        }
+    }
+
+    /** {@link Flags#allAppsBlur()} when the user enabled the app drawer blur. */
+    public static boolean allAppsBlur() {
+        load();
+        return Flags.allAppsBlur() && sBlurAllApps;
+    }
+
+    /** {@link Flags#enableOverviewBackgroundWallpaperBlur()} when the user enabled it. */
+    public static boolean enableOverviewBackgroundWallpaperBlur() {
+        load();
+        return Flags.enableOverviewBackgroundWallpaperBlur() && sBlurOverview;
+    }
+
+    /** Whether the app drawer may be blurred at all (enhanced or legacy depth blur). */
+    public static boolean blurAllAppsEnabled() {
+        load();
+        return sBlurAllApps;
+    }
+
+    /** Whether overview may be blurred at all. */
+    public static boolean blurOverviewEnabled() {
+        load();
+        return sBlurOverview;
+    }
+
+    /** Whether the launcher may blur behind apps (launching, closing, widgets, other states). */
+    public static boolean blurBehindAppsEnabled() {
+        load();
+        return sBlurBehindApps;
+    }
+
+    /** Whether windows keep their rounded corners while the launcher animates them. */
+    public static boolean windowCornersEnabled() {
+        load();
+        return sWindowCorners;
+    }
+}
